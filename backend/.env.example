# EVE FastAPI Backend environment variable configuration template.
# Copy this file to '.env' in the backend directory and customize values.

# Application Environment (development / production)
ENV=development
ENVIRONMENT=development

# JWT Secret Key (used for session signatures)
SECRET_KEY=generate-a-long-random-hex-string-for-security

# Supabase Auth Configuration
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-signing-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-if-required

# Database Connection (PostgreSQL connection string with pgvector extension)
DATABASE_URL=postgresql://user:password@host:port/database

# External APIs
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MOCK_MODE=True

# Google Cloud Storage (optional integration)
GCS_BUCKET_NAME=your-gcs-bucket-name

# ---------------------------------------------------------------------------
# Integrations (Shopify / Telegram / WhatsApp) — see docs/INTEGRATIONS.md
#
# All of these are OPTIONAL. Leaving a block empty disables that integration
# and the app still boots; the Integrations page reports it as unconfigured.
# NEVER commit real values — this file is a template only.
# ---------------------------------------------------------------------------

# Public HTTPS base URL of THIS backend. Shopify, Telegram and Meta call us at
# absolute URLs, so this cannot be inferred from the incoming request.
# Local development: use an HTTPS tunnel (e.g. `cloudflared tunnel --url http://localhost:8000`).
BACKEND_PUBLIC_URL=https://your-backend-host

# Encrypts stored integration credentials at rest. Optional: when empty, the key
# is derived from SECRET_KEY. Set it explicitly to rotate integration
# credentials independently of the JWT signing key.
# Changing this value invalidates every stored token — stores must reconnect.
INTEGRATION_ENCRYPTION_KEY=

# --- Shopify app (Partner Dashboard -> Apps -> your app -> Client credentials) ---
# Per-store access tokens are obtained via OAuth and stored encrypted in the
# database; they are NOT configured here.
SHOPIFY_API_KEY=your-shopify-app-client-id
SHOPIFY_API_SECRET=your-shopify-app-client-secret
SHOPIFY_SCOPES=read_products,read_inventory,read_orders
SHOPIFY_API_VERSION=2024-07
SHOPIFY_ORDER_SYNC_DAYS=90

# --- Telegram bot (create via @BotFather) ---
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token
# Any long random string. Registered with setWebhook and echoed back by Telegram
# in X-Telegram-Bot-Api-Secret-Token. Required — without it the webhook rejects
# every update rather than accepting anonymous ones.
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string

# --- WhatsApp Business Cloud API (Meta App Dashboard) ---
WHATSAPP_ACCESS_TOKEN=your-meta-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
# Any string you choose; entered identically in Meta's webhook setup form.
WHATSAPP_VERIFY_TOKEN=generate-a-long-random-string
# App secret, used to verify X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_API_VERSION=v21.0
