# EVE Frontend environment variable configuration template.
# Copy this file to '.env.local' in the frontend directory and customize values.

# Supabase Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-anonymous-key

# API Endpoint URL (pointing to FastAPI gateway)
NEXT_PUBLIC_API_URL=http://localhost:8000
