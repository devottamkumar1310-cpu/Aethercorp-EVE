# ==============================================================================
# AETHERCORP EVE - GLOBAL GITIGNORE
# ==============================================================================

# 1. Environment Variables & Secrets
# .env.example files ARE tracked: they document required configuration.
# Keep the negation AFTER the broad patterns so it wins (last match wins).
.env
.env.*
*.env
!.env.example
!**/.env.example

# 2. Python & Backend
__pycache__/
*.py[cod]
*$py.class
*.so

# Test & lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
coverage.xml
htmlcov/

# Environments
venv/
.venv/
env/
ENV/
.env_python/

# Databases (local/test only — EVE uses managed Postgres in every environment)
*.db
*.sqlite
*.sqlite3

# 3. Next.js, Node & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.next/
out/
build/
dist/
.vercel/
*.tsbuildinfo

# 4. OS Specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 5. IDEs & local agent/tool workspace state
.idea/
.vscode/
.vs/
.gemini/
.claude/
.codex/
.cursor/

# 6. Runtime & generated artifacts
# Document uploads (merchant data — never committed)
uploads/
backend/uploads/
# Generated audit/benchmark output (see app/audit/evaluator.py)
reports/
backups/
# Logs and scratch files
*.log
*.tmp
test_results.txt
